# Keys. Copy to .env and fill in, or export TYPESAFE_API_KEY directly.
# Never commit a real key.
TYPESAFE_API_KEY=

# Only needed if you use a hosted gateway instead of the official endpoint.
# The SDK appends /v1/systemone to this, so give the API root.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
